{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/codekeeper": {
      "release-type": "node",
      "component": "codekeeper",
      "package-name": "@coryparry/codekeeper",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "/CHANGELOG.md",
      "pull-request-title-pattern": "chore(release): prepare Codekeeper ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": "/packages/codekeeper/runtime-package/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/packages/codekeeper/runtime-package/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/packages/codekeeper/runtime-package/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}

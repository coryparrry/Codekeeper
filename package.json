{
  "name": "codekeeper-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "package:stage": "node scripts/build-codekeeper-package.mjs",
    "package:stage:check": "node --test packages/codekeeper/test/package-stage.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write package.json eslint.config.mjs tools/codekeeper/src/lib/commands.mjs tools/codekeeper/test/commands.test.mjs",
    "format:check": "prettier --check package.json eslint.config.mjs tools/codekeeper/src/lib/commands.mjs tools/codekeeper/test/commands.test.mjs",
    "check": "npm run lint && npm run format:check && bash scripts/release-source.sh --verify-worktree"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "prettier": "3.9.6"
  }
}

{
  "version": 1,
  "repository": {
    "displayName": "Example Repository",
    "defaultBranch": "main",
    "ownerLogins": [
      "repository-owner"
    ],
    "automationBranchPrefix": "automation/ai-maintainer/"
  },
  "projectInvariants": [
    "Keep changes narrow, understandable, and directly supported by repository evidence.",
    "Do not add accounts, external services, permissions, or architectural machinery unless the approved issue requires them.",
    "Do not change repository automation, security policy, release configuration, or credentials outside the explicit path policy."
  ],
  "ai": {
    "review": {
      "model": "gpt-5.6-sol",
      "effort": "high"
    },
    "audit": {
      "model": "gpt-5.6-sol",
      "effort": "high"
    },
    "issue": {
      "model": "gpt-5.6-luna",
      "effort": "max"
    },
    "fix": {
      "model": "gpt-5.6-terra",
      "effort": "high"
    }
  },
  "labels": {
    "ai-maintainer:reviewed": {
      "color": "5319E7",
      "description": "Reviewed by AI Maintainer"
    },
    "ai-maintainer:maintenance": {
      "color": "0E8A16",
      "description": "Created or managed by AI Maintainer"
    },
    "ai-maintainer:ready": {
      "color": "1D76DB",
      "description": "Sufficiently bounded for implementation"
    },
    "ai-maintainer:blocked": {
      "color": "B60205",
      "description": "AI review found a blocking problem"
    },
    "ai-maintainer:manual-review": {
      "color": "FBCA04",
      "description": "Requires human judgment before merge"
    },
    "ai-maintainer:auto-merge": {
      "color": "0E8A16",
      "description": "Eligible for policy-controlled auto-merge"
    },
    "ai-maintainer:duplicate-candidate": {
      "color": "CFD3D7",
      "description": "Likely duplicate requiring confirmation"
    },
    "ai-maintainer:needs-tests": {
      "color": "D4C5F9",
      "description": "Additional tests are required"
    },
    "ai-maintainer:priority-p1": {
      "color": "B60205",
      "description": "Highest priority"
    },
    "ai-maintainer:priority-p2": {
      "color": "FBCA04",
      "description": "Important but not urgent"
    },
    "ai-maintainer:priority-p3": {
      "color": "C5DEF5",
      "description": "Normal priority"
    },
    "ai-maintainer:risk-low": {
      "color": "0E8A16",
      "description": "Low-risk change"
    },
    "ai-maintainer:risk-medium": {
      "color": "FBCA04",
      "description": "Medium-risk change"
    },
    "ai-maintainer:risk-high": {
      "color": "B60205",
      "description": "High-risk change"
    },
    "ai-maintainer:type-bug": {
      "color": "D73A4A",
      "description": "Correctness defect"
    },
    "ai-maintainer:type-enhancement": {
      "color": "A2EEEF",
      "description": "Feature or product enhancement"
    },
    "ai-maintainer:type-documentation": {
      "color": "0075CA",
      "description": "Documentation work"
    },
    "ai-maintainer:type-question": {
      "color": "D876E3",
      "description": "Question or clarification"
    },
    "ai-maintainer:type-maintenance": {
      "color": "C5DEF5",
      "description": "Repository maintenance"
    },
    "ai-maintainer:type-security": {
      "color": "B60205",
      "description": "Security-sensitive work"
    },
    "ai-maintainer:type-testing": {
      "color": "BFDADC",
      "description": "Test coverage or infrastructure"
    }
  },
  "review": {
    "maximumBlockingFindings": 8,
    "maximumNonBlockingFindings": 8,
    "allowedLabels": [
      "ai-maintainer:type-bug",
      "ai-maintainer:type-documentation",
      "ai-maintainer:type-enhancement",
      "ai-maintainer:type-maintenance",
      "ai-maintainer:type-question",
      "ai-maintainer:type-security",
      "ai-maintainer:type-testing",
      "ai-maintainer:needs-tests"
    ],
    "managedLabels": [
      "ai-maintainer:reviewed",
      "ai-maintainer:blocked",
      "ai-maintainer:manual-review",
      "ai-maintainer:auto-merge",
      "ai-maintainer:needs-tests",
      "ai-maintainer:risk-low",
      "ai-maintainer:risk-medium",
      "ai-maintainer:risk-high",
      "ai-maintainer:type-bug",
      "ai-maintainer:type-documentation",
      "ai-maintainer:type-enhancement",
      "ai-maintainer:type-maintenance",
      "ai-maintainer:type-question",
      "ai-maintainer:type-security",
      "ai-maintainer:type-testing"
    ]
  },
  "audit": {
    "maximumIssuesPerRun": 5,
    "repair": {
      "allowedPaths": [
        "README.md",
        "*.md",
        "docs/**/*.md",
        "src/**",
        "lib/**",
        "app/**",
        "packages/**",
        "test/**",
        "tests/**",
        "scripts/**"
      ],
      "protectedPaths": [
        ".github/**",
        ".codex/**",
        ".claude/**",
        "**/AGENTS.md",
        "**/CLAUDE.md",
        "**/SECURITY.md",
        "**/CODEOWNERS",
        ".gitattributes",
        ".gitmodules",
        "LICENSE",
        "LICENSE.*",
        "tools/ai-maintainer/**",
        "**/*.xcodeproj/**",
        "**/*.xcworkspace/**",
        "**/*.entitlements",
        "**/*Info.plist",
        "**/*Signing*",
        "**/*signing*",
        "**/*Migration*",
        "**/*migration*",
        "**/*Security*",
        "**/*security*",
        "Package.resolved"
      ],
      "allowAdd": true,
      "maximumFiles": 8,
      "maximumChangedLines": 500,
      "maximumPatchBytes": 524288,
      "maximumFileBytes": 262144,
      "validationCommands": [
        "git diff --check"
      ]
    }
  },
  "issues": {
    "closeExactDuplicates": false,
    "maximumOpenIssueContext": 50,
    "managedLabels": [
      "ai-maintainer:maintenance",
      "ai-maintainer:ready",
      "ai-maintainer:manual-review",
      "ai-maintainer:duplicate-candidate",
      "ai-maintainer:priority-p1",
      "ai-maintainer:priority-p2",
      "ai-maintainer:priority-p3",
      "ai-maintainer:risk-low",
      "ai-maintainer:risk-medium",
      "ai-maintainer:risk-high",
      "ai-maintainer:type-bug",
      "ai-maintainer:type-documentation",
      "ai-maintainer:type-enhancement",
      "ai-maintainer:type-maintenance",
      "ai-maintainer:type-question",
      "ai-maintainer:type-security",
      "ai-maintainer:type-testing",
      "ai-maintainer:needs-tests"
    ]
  },
  "merge": {
    "enabled": true,
    "method": "SQUASH",
    "allowAutomationPullRequests": true,
    "allowUserPullRequests": false,
    "allowedUserAuthors": [
      "repository-owner"
    ],
    "maximumFiles": 5,
    "maximumChangedLines": 250,
    "allowedPaths": [
      "README.md",
      "*.md",
      "docs/**/*.md"
    ],
    "blockedPaths": [
      ".github/**",
      ".codex/**",
      ".claude/**",
      "**/AGENTS.md",
      "**/CLAUDE.md",
      "**/SECURITY.md",
      "**/CODEOWNERS",
      ".gitattributes",
      ".gitmodules",
      "LICENSE",
      "LICENSE.*",
      "tools/ai-maintainer/**",
      "src/**",
      "lib/**",
      "app/**",
      "packages/**",
      "test/**",
      "tests/**",
      "**/*.xcodeproj/**",
      "**/*.xcworkspace/**",
      "**/*.entitlements",
      "**/*Info.plist",
      ".gitignore",
      "Package.resolved"
    ]
  }
}

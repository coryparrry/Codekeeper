{
  "version": 3,
  "repository": {
    "displayName": "Example Repository",
    "defaultBranch": "main",
    "ownerLogins": [
      "repository-owner"
    ],
    "automationBranchPrefix": "automation/codekeeper/"
  },
  "projectInvariants": [
    "Keep changes narrow, understandable, and directly supported by repository evidence.",
    "Do not add accounts, external services, permissions, or architectural machinery unless the approved issue requires them.",
    "Do not change repository automation, security policy, release configuration, or credentials outside the explicit path policy."
  ],
  "automation": {
    "automaticPrReview": true,
    "reviewFeedbackTriage": true,
    "issueTriage": true,
    "ownerRequests": true,
    "maintenanceSchedule": "17 7 * * *"
  },
  "ai": {
    "tracing": {
      "enabled": true,
      "includeSensitiveData": false
    },
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "api": "responses",
        "structuredOutputs": true,
        "supportsReasoningEffort": true
      },
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "chat_completions",
        "structuredOutputs": false,
        "supportsReasoningEffort": false
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "chat_completions",
        "structuredOutputs": false,
        "supportsReasoningEffort": false
      }
    },
    "agents": {
      "review": {
        "provider": "openai",
        "model": "gpt-5.6-sol",
        "effort": "high",
        "maxTurns": 1,
        "maximumAttempts": 2,
        "modelSettings": {
          "text": {
            "verbosity": "low"
          }
        },
        "workspace": {
          "enabled": true,
          "allowWrites": false,
          "model": "gpt-5.6-sol",
          "effort": "high"
        }
      },
      "audit": {
        "provider": "openai",
        "model": "gpt-5.6-sol",
        "effort": "high",
        "maxTurns": 1,
        "maximumAttempts": 2,
        "modelSettings": {
          "text": {
            "verbosity": "low"
          }
        },
        "workspace": {
          "enabled": true,
          "allowWrites": true,
          "model": "gpt-5.6-sol",
          "effort": "high"
        }
      },
      "issue": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "effort": "none",
        "maxTurns": 1,
        "maximumAttempts": 2,
        "modelSettings": {
          "temperature": 0.2,
          "providerData": {
            "thinking": {
              "type": "disabled"
            },
            "response_format": {
              "type": "json_object"
            }
          }
        },
        "workspace": {
          "enabled": false,
          "allowWrites": false,
          "model": "gpt-5.6-sol",
          "effort": "low"
        }
      },
      "fix": {
        "provider": "openai",
        "model": "gpt-5.6-terra",
        "effort": "high",
        "maxTurns": 1,
        "maximumAttempts": 2,
        "modelSettings": {
          "text": {
            "verbosity": "low"
          }
        },
        "workspace": {
          "enabled": true,
          "allowWrites": true,
          "model": "gpt-5.6-terra",
          "effort": "high"
        }
      }
    }
  },
  "labels": {
    "reviewed": {
      "color": "5319E7",
      "description": "Automated review complete"
    },
    "ready": {
      "color": "1D76DB",
      "description": "Sufficiently bounded for implementation"
    },
    "blocked": {
      "color": "B60205",
      "description": "AI review found a blocking problem"
    },
    "manual review": {
      "color": "FBCA04",
      "description": "Requires human judgment before merge"
    },
    "paused": {
      "color": "FBCA04",
      "description": "Automatic work is paused"
    },
    "auto repaired": {
      "color": "0E8A16",
      "description": "Automatically repaired"
    },
    "auto merge": {
      "color": "0E8A16",
      "description": "Eligible for policy-controlled auto-merge"
    },
    "duplicate": {
      "color": "CFD3D7",
      "description": "Likely duplicate requiring confirmation"
    },
    "deferred": {
      "color": "C5DEF5",
      "description": "Verified work deferred from a pull request"
    },
    "needs tests": {
      "color": "D4C5F9",
      "description": "Additional tests are required"
    },
    "priority p1": {
      "color": "B60205",
      "description": "Highest priority"
    },
    "priority p2": {
      "color": "FBCA04",
      "description": "Important but not urgent"
    },
    "priority p3": {
      "color": "C5DEF5",
      "description": "Normal priority"
    },
    "risk low": {
      "color": "0E8A16",
      "description": "Low-risk change"
    },
    "risk medium": {
      "color": "FBCA04",
      "description": "Medium-risk change"
    },
    "risk high": {
      "color": "B60205",
      "description": "High-risk change"
    },
    "bug": {
      "color": "D73A4A",
      "description": "Correctness defect"
    },
    "enhancement": {
      "color": "A2EEEF",
      "description": "Feature or product enhancement"
    },
    "documentation": {
      "color": "0075CA",
      "description": "Documentation work"
    },
    "question": {
      "color": "D876E3",
      "description": "Question or clarification"
    },
    "maintenance": {
      "color": "C5DEF5",
      "description": "Repository maintenance"
    },
    "security": {
      "color": "B60205",
      "description": "Security-sensitive work"
    },
    "testing": {
      "color": "BFDADC",
      "description": "Test coverage or infrastructure"
    }
  },
  "review": {
    "autoRepair": false,
    "createDeferredIssues": true,
    "maximumBlockingFindings": 8,
    "maximumNonBlockingFindings": 8,
    "allowedLabels": [
      "bug",
      "documentation",
      "enhancement",
      "maintenance",
      "question",
      "security",
      "testing",
      "needs tests"
    ],
    "managedLabels": [
      "reviewed",
      "blocked",
      "manual review",
      "auto merge",
      "needs tests",
      "risk low",
      "risk medium",
      "risk high",
      "bug",
      "documentation",
      "enhancement",
      "maintenance",
      "question",
      "security",
      "testing"
    ],
    "maximumDiffBytes": 262144,
    "maximumChangedFiles": 500,
    "includeDiffInAgentContext": true
  },
  "audit": {
    "maximumIssuesPerRun": 5,
    "repair": {
      "enabled": false,
      "allowedPaths": [
        "README.md",
        "*.md",
        "docs/**/*.md",
        "src/**",
        "lib/**",
        "app/**",
        "packages/**",
        "test/**",
        "tests/**",
        "scripts/**"
      ],
      "protectedPaths": [
        ".github/**",
        ".codex/**",
        ".claude/**",
        "**/AGENTS.md",
        "**/CLAUDE.md",
        "**/SECURITY.md",
        "**/CODEOWNERS",
        ".gitattributes",
        ".gitmodules",
        "LICENSE",
        "LICENSE.*",
        "tools/codekeeper/**",
        "**/*.xcodeproj/**",
        "**/*.xcworkspace/**",
        "**/*.entitlements",
        "**/*Info.plist",
        "**/*Signing*",
        "**/*signing*",
        "**/*Migration*",
        "**/*migration*",
        "**/*Security*",
        "**/*security*",
        "Package.resolved"
      ],
      "allowAdd": true,
      "maximumFiles": 8,
      "maximumChangedLines": 500,
      "maximumPatchBytes": 524288,
      "maximumFileBytes": 262144,
      "validationCommands": [
        "git diff --check"
      ]
    }
  },
  "issues": {
    "allowAiImplementation": false,
    "closeExactDuplicates": false,
    "closeResolvedIssues": true,
    "maximumOpenIssueContext": 50,
    "managedLabels": [
      "ready",
      "manual review",
      "duplicate",
      "deferred",
      "priority p1",
      "priority p2",
      "priority p3",
      "risk low",
      "risk medium",
      "risk high",
      "bug",
      "documentation",
      "enhancement",
      "maintenance",
      "question",
      "security",
      "testing",
      "needs tests"
    ]
  },
  "merge": {
    "enabled": false,
    "method": "SQUASH",
    "allowAutomationPullRequests": true,
    "allowUserPullRequests": false,
    "allowedUserAuthors": [
      "repository-owner"
    ],
    "maximumFiles": 5,
    "maximumChangedLines": 250,
    "allowedPaths": [
      "README.md",
      "*.md",
      "docs/**/*.md"
    ],
    "blockedPaths": [
      ".github/**",
      ".codex/**",
      ".claude/**",
      "**/AGENTS.md",
      "**/CLAUDE.md",
      "**/SECURITY.md",
      "**/CODEOWNERS",
      ".gitattributes",
      ".gitmodules",
      "LICENSE",
      "LICENSE.*",
      "tools/codekeeper/**",
      "src/**",
      "lib/**",
      "app/**",
      "packages/**",
      "test/**",
      "tests/**",
      "**/*.xcodeproj/**",
      "**/*.xcworkspace/**",
      "**/*.entitlements",
      "**/*Info.plist",
      ".gitignore",
      "Package.resolved"
    ]
  }
}

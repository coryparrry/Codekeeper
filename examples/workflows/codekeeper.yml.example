# Generated by the Codekeeper installer from one exact published package release.
name: Codekeeper
run-name: "${{ inputs.verify_app_credentials && format('Codekeeper App credential verification {0}', inputs.verification_id) || (github.event_name == 'workflow_dispatch' && inputs.issue_number != '' && format('Codekeeper manual fix #{0}', inputs.issue_number) || (github.event_name == 'workflow_dispatch' && format('Codekeeper maintenance verification {0}', inputs.verification_id || github.run_id) || format('Codekeeper {0} #{1}', github.event_name, github.event.pull_request.number || github.event.issue.number || github.event.client_payload.number || github.run_number))) }}"

# Rendered automation controls used for release-owned preflight recovery.
# owner_requests: OWNER_REQUESTS_ENABLED
# auto_review: AUTO_REVIEW_ENABLED
# feedback_triage: FEEDBACK_TRIAGE_ENABLED
# auto_triage: AUTO_TRIAGE_ENABLED

on:
  pull_request_target:
    types: [opened, reopened, synchronize, ready_for_review]
  pull_request_review:
    types: [submitted, edited, dismissed]
  pull_request_review_comment:
    types: [created, edited, deleted]
  issues:
    types: [opened, reopened, edited, closed, labeled]
  issue_comment:
    types: [created]
  repository_dispatch:
    types: [codekeeper_review, codekeeper_issue, codekeeper_fix]
  schedule:
    - cron: "17 7 * * *"
  workflow_dispatch:
    inputs:
      dry_run:
        description: Run report-only maintenance (true) or allow configured live maintenance (false)
        required: true
        type: boolean
        default: true
      verification_id:
        description: Optional installer verification correlation ID
        required: false
        type: string
        default: ""
      issue_number:
        description: Issue number for an explicitly requested manual fix
        required: false
        type: string
        default: ""
      verify_app_credentials:
        description: Run the no-mutation GitHub App credential proof
        required: false
        type: boolean
        default: false

permissions:
  contents: read

jobs:
  review:
    # Keep this caller job stable: the reusable runtime publishes the protected
    # "Codekeeper review gate" check and fails it closed when review is disabled.
    # CODEKEEPER_OWNER_COMMANDS_START
    if: >-
      (github.event_name == 'pull_request_target' ||
       github.event_name == 'pull_request_review' ||
       github.event_name == 'pull_request_review_comment' ||
       (github.event_name == 'repository_dispatch' && github.event.action == 'codekeeper_review')) &&
      !(
        github.event_name == 'pull_request_review_comment' &&
        (
          contains(fromJSON('["/codekeeper help","/codekeeper status","/codekeeper review","/codekeeper rerun","/codekeeper triage","/codekeeper implement","/codekeeper repair","/codekeeper fix","/codekeeper defer","/codekeeper pause","/codekeeper stop"]'), github.event.comment.body) ||
          (
            vars.CODEKEEPER_AUTOMATION_BOT_LOGIN != '' &&
            startsWith(github.event.comment.body, '@') &&
            (endsWith(github.event.comment.body, ' help') ||
             endsWith(github.event.comment.body, ' status') ||
             endsWith(github.event.comment.body, ' review') ||
             endsWith(github.event.comment.body, ' rerun') ||
             endsWith(github.event.comment.body, ' triage') ||
             endsWith(github.event.comment.body, ' implement') ||
             endsWith(github.event.comment.body, ' repair') ||
             endsWith(github.event.comment.body, ' fix') ||
             endsWith(github.event.comment.body, ' defer') ||
             endsWith(github.event.comment.body, ' pause') ||
             endsWith(github.event.comment.body, ' stop'))
          )
        )
      ) &&
      !(
        (github.event_name == 'pull_request_review' ||
         github.event_name == 'pull_request_review_comment') &&
        (vars.CODEKEEPER_AUTOMATION_BOT_LOGIN == '' ||
         github.event.review.user.login == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN ||
         github.event.comment.user.login == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN)
      )
    # CODEKEEPER_OWNER_COMMANDS_END
    uses: ./.github/workflows/codekeeper-runtime.yml
    with:
      mode: review
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      installed_modes: "INSTALLED_MODES"
      enabled: >-
        ${{
          vars.CODEKEEPER_ENABLED == 'true' &&
          (
            (github.event_name == 'repository_dispatch' &&
             github.actor == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN) ||
            (github.event.pull_request.head.repo.full_name == github.repository &&
             github.event.pull_request.base.repo.full_name == github.repository &&
             (
               (fromJSON('AUTO_REVIEW_ENABLED') &&
                github.event_name == 'pull_request_target') ||
               (fromJSON('FEEDBACK_TRIAGE_ENABLED') &&
                (github.event_name == 'pull_request_review' ||
                 github.event_name == 'pull_request_review_comment'))
             ))
          )
        }}
      dry_run: false
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      deepseek_api_key: ${{ secrets.DEEPSEEK_API_KEY }}
      openrouter_api_key: ${{ secrets.OPENROUTER_API_KEY }}
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

  issue:
    # CODEKEEPER_OWNER_COMMANDS_START
    if: >-
      vars.CODEKEEPER_ENABLED == 'true' &&
      !github.event.issue.pull_request &&
      (
        (fromJSON('AUTO_TRIAGE_ENABLED') &&
         (
           (github.event_name == 'issues' &&
            contains(fromJSON('["opened","reopened","edited","closed"]'), github.event.action)) ||
           (github.event_name == 'issue_comment' &&
            github.event.action == 'created' &&
            contains(github.event.issue.labels.*.name, 'codekeeper:needs-information') &&
            github.event.comment.user.login != vars.CODEKEEPER_AUTOMATION_BOT_LOGIN &&
            (github.event.comment.user.login == github.event.issue.user.login ||
             contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association)) &&
            !contains(fromJSON('["/codekeeper help","/codekeeper status","/codekeeper review","/codekeeper rerun","/codekeeper triage","/codekeeper implement","/codekeeper repair","/codekeeper fix","/codekeeper defer","/codekeeper pause","/codekeeper stop"]'), github.event.comment.body) &&
            !(vars.CODEKEEPER_AUTOMATION_BOT_LOGIN != '' &&
              startsWith(github.event.comment.body, '@')))
         )) ||
        (github.event_name == 'repository_dispatch' &&
         github.event.action == 'codekeeper_issue' &&
         vars.CODEKEEPER_AUTOMATION_BOT_LOGIN != '' &&
         github.actor == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN)
      )
    # CODEKEEPER_OWNER_COMMANDS_END
    uses: ./.github/workflows/codekeeper-runtime.yml
    with:
      mode: issues
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      installed_modes: "INSTALLED_MODES"
      enabled: true
      dry_run: false
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      deepseek_api_key: ${{ secrets.DEEPSEEK_API_KEY }}
      openrouter_api_key: ${{ secrets.OPENROUTER_API_KEY }}
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

  fix:
    if: >-
      vars.CODEKEEPER_ENABLED == 'true' &&
      (
        (github.event_name == 'workflow_dispatch' &&
         !inputs.verify_app_credentials &&
         inputs.issue_number != '') ||
        (github.event_name == 'repository_dispatch' &&
         github.event.action == 'codekeeper_fix' &&
         vars.CODEKEEPER_AUTOMATION_BOT_LOGIN != '' &&
         github.actor == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN) ||
        (github.event_name == 'issues' &&
         github.event.action == 'labeled' &&
         github.event.label.name == 'codekeeper:ready' &&
         github.event.sender.login == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN)
      )
    uses: ./.github/workflows/codekeeper-runtime.yml
    with:
      mode: fix
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      installed_modes: "INSTALLED_MODES"
      enabled: true
      dry_run: ${{ github.event_name == 'workflow_dispatch' && inputs.dry_run }}
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      deepseek_api_key: ${{ secrets.DEEPSEEK_API_KEY }}
      openrouter_api_key: ${{ secrets.OPENROUTER_API_KEY }}
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

  maintain:
    if: >-
      vars.CODEKEEPER_ENABLED == 'true' &&
      (github.event_name == 'schedule' ||
       (github.event_name == 'workflow_dispatch' &&
        !inputs.verify_app_credentials &&
        inputs.issue_number == ''))
    uses: ./.github/workflows/codekeeper-runtime.yml
    with:
      mode: maintain
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      installed_modes: "INSTALLED_MODES"
      enabled: true
      dry_run: ${{ github.event_name == 'schedule' || inputs.dry_run }}
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      deepseek_api_key: ${{ secrets.DEEPSEEK_API_KEY }}
      openrouter_api_key: ${{ secrets.OPENROUTER_API_KEY }}
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

  command:
    # This is only a syntactic admission filter. The generic runtime parses the
    # original event and verifies association plus repository.ownerLogins.
    # CODEKEEPER_OWNER_COMMANDS_START
    if: >-
      (github.event_name == 'workflow_dispatch' && inputs.verify_app_credentials) ||
      (
        vars.CODEKEEPER_ENABLED == 'true' &&
        fromJSON('OWNER_REQUESTS_ENABLED') &&
        github.event.action == 'created' &&
        (github.event_name == 'issue_comment' ||
         github.event_name == 'pull_request_review_comment') &&
        github.event.comment.user.login != vars.CODEKEEPER_AUTOMATION_BOT_LOGIN &&
        (
          contains(fromJSON('["/codekeeper help","/codekeeper status","/codekeeper review","/codekeeper rerun","/codekeeper triage","/codekeeper implement","/codekeeper repair","/codekeeper fix","/codekeeper defer","/codekeeper pause","/codekeeper stop"]'), github.event.comment.body) ||
          (
            vars.CODEKEEPER_AUTOMATION_BOT_LOGIN != '' &&
            startsWith(github.event.comment.body, '@') &&
            (endsWith(github.event.comment.body, ' help') ||
             endsWith(github.event.comment.body, ' status') ||
             endsWith(github.event.comment.body, ' review') ||
             endsWith(github.event.comment.body, ' rerun') ||
             endsWith(github.event.comment.body, ' triage') ||
             endsWith(github.event.comment.body, ' implement') ||
             endsWith(github.event.comment.body, ' repair') ||
             endsWith(github.event.comment.body, ' fix') ||
             endsWith(github.event.comment.body, ' defer') ||
             endsWith(github.event.comment.body, ' pause') ||
             endsWith(github.event.comment.body, ' stop'))
          )
        )
      )
    # CODEKEEPER_OWNER_COMMANDS_END
    uses: ./.github/workflows/codekeeper-runtime.yml
    with:
      mode: auto
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      installed_modes: "INSTALLED_MODES"
      enabled: true
      dry_run: false
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
      credential_probe: ${{ github.event_name == 'workflow_dispatch' && inputs.verify_app_credentials }}
      verification_id: ${{ inputs.verification_id || '' }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      deepseek_api_key: ${{ secrets.DEEPSEEK_API_KEY }}
      openrouter_api_key: ${{ secrets.OPENROUTER_API_KEY }}
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

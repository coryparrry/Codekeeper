# Copy to .github/workflows/ai-maintainer-fix.yml, then replace OWNER/REPOSITORY
# and FULL_COMMIT_SHA with the published maintainer repository and release commit.
name: AI Maintainer issue implementation

on:
  issue_comment:
    types: [created]
  workflow_dispatch:
    inputs:
      issue_number:
        description: Open issue to implement
        required: true
        type: string
      dry_run:
        description: Validate and seal without opening a pull request
        required: true
        type: boolean
        default: true

permissions:
  contents: read
  issues: read

jobs:
  fix:
    uses: OWNER/REPOSITORY/.github/workflows/ai-maintainer-fix.yml@FULL_COMMIT_SHA
    with:
      enabled: ${{ vars.AI_MAINTAINER_ENABLED == 'true' }}
      issue_number: ${{ inputs.issue_number || '' }}
      dry_run: ${{ inputs.dry_run || false }}
      app_client_id: ${{ vars.AI_MAINTAINER_APP_CLIENT_ID }}
    secrets:
      # Match this secret to ai.agents.fix.provider in .github/ai-maintainer.json.
      model_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Required while this mode keeps workspace.enabled=true.
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Always a separate OpenAI trace-export key, never the model-provider key.
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.AI_MAINTAINER_APP_PRIVATE_KEY }}

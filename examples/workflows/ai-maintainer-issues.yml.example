# Copy to .github/workflows/ai-maintainer-issues.yml, then replace OWNER/REPOSITORY
# and FULL_COMMIT_SHA with the published maintainer repository and release commit.
name: AI Maintainer issue triage

on:
  issue_comment:
    types: [created]

permissions:
  contents: read
  issues: read

jobs:
  triage:
    uses: OWNER/REPOSITORY/.github/workflows/ai-maintainer-issues.yml@FULL_COMMIT_SHA
    with:
      enabled: ${{ vars.AI_MAINTAINER_ENABLED == 'true' }}
      app_client_id: ${{ vars.AI_MAINTAINER_APP_CLIENT_ID }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      app_private_key: ${{ secrets.AI_MAINTAINER_APP_PRIVATE_KEY }}

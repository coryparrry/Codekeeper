# Generated by the Codekeeper installer from one exact published package release.
name: Codekeeper issue triage
run-name: "Codekeeper issue triage #${{ github.event.issue.number || github.event.client_payload.number }}"

on:
  issues:
    types: [opened, reopened, edited, closed]
  repository_dispatch:
    types: [codekeeper_issue]

permissions:
  contents: read
  issues: read
  pull-requests: read

jobs:
  bootstrap:
    name: Codekeeper exact package bootstrap
    permissions:
      contents: read
    uses: ./.github/workflows/codekeeper-bootstrap.yml
    with:
      runner: ${{ vars.CODEKEEPER_RUNNER || 'ubuntu-latest' }}
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
  triage:
    needs: bootstrap
    uses: ./.github/workflows/codekeeper-runtime-issues.yml
    with:
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      package_manifest_sha256: ${{ needs.bootstrap.outputs.package_manifest_sha256 }}
      package_source_commit: ${{ needs.bootstrap.outputs.source_commit }}
      enabled: ${{ vars.CODEKEEPER_ENABLED == 'true' }}
      runner: ${{ vars.CODEKEEPER_RUNNER || 'ubuntu-latest' }}
      auto_triage: true
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
    secrets:
      # Match this secret to ai.agents.issue.provider in .github/codekeeper.json.
      model_api_key: ${{ secrets.DEEPSEEK_API_KEY }}
      # Required while this mode keeps workspace.enabled=true.
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Traces still export to OpenAI, so this must not be the DeepSeek key.
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

# Generated by the Codekeeper installer from one exact published package release.
name: Codekeeper repository assistant
run-name: ${{ github.event_name == 'workflow_dispatch' && format('Codekeeper App credential verification {0}', inputs.verification_id) || format('Codekeeper assistant #{0}', github.event.issue.number || github.event.pull_request.number) }}

on:
  workflow_dispatch:
    inputs:
      verification_id:
        description: Unique Codekeeper verification correlation ID
        required: true
        type: string
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

permissions:
  contents: read
  issues: read
  pull-requests: read

jobs:
  intent:
    name: Detect a Codekeeper owner request
    if: github.event_name != 'workflow_dispatch'
    runs-on: ubuntu-latest
    outputs:
      route: ${{ steps.intent.outputs.route }}
    steps:
      - name: Match one supported command or bot mention
        id: intent
        env:
          COMMENT_BODY: ${{ github.event.comment.body }}
          AUTHOR_ASSOCIATION: ${{ github.event.comment.author_association }}
          AUTOMATION_BOT_LOGIN: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
        run: |
          node --input-type=module -e '
            import { appendFileSync } from "node:fs";
            const body = String(process.env.COMMENT_BODY ?? "").trim().toLowerCase();
            const association = String(process.env.AUTHOR_ASSOCIATION ?? "");
            const bot = String(process.env.AUTOMATION_BOT_LOGIN ?? "").replace(/\[bot\]$/i, "").toLowerCase();
            const escapedBot = bot.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            // CODEKEEPER_OWNER_COMMANDS_START
            const actions = ["help","status","review","rerun","triage","implement","repair","fix","defer","pause","stop"];
            // CODEKEEPER_OWNER_COMMANDS_END
            const slash = new RegExp(`^/codekeeper\\s+(${actions.join("|")})$`, "i").test(body);
            const mentioned = bot && new RegExp(`^@${escapedBot}\\s+(${actions.join("|")})$`, "i").test(body);
            const trustedAssociation = ["OWNER", "MEMBER", "COLLABORATOR"].includes(association);
            appendFileSync(process.env.GITHUB_OUTPUT, `route=${trustedAssociation && (slash || mentioned)}\n`);
          '
  verify-app:
    name: Codekeeper App credential verification
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    steps:
      - name: Validate verification request and permission inputs
        env:
          VERIFICATION_ID: ${{ inputs.verification_id }}
        run: |
          [[ "$VERIFICATION_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || {
            echo "Invalid Codekeeper verification correlation ID" >&2
            exit 1
          }
      - name: Create repository-scoped GitHub App token
        id: app-token
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3
        with:
          client-id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
          private-key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}
          permission-contents: "VERIFY_APP_CONTENTS_PERMISSION"
          permission-issues: "VERIFY_APP_ISSUES_PERMISSION"
          permission-pull-requests: "VERIFY_APP_PULL_REQUESTS_PERMISSION"
      - name: Prove App identity, installation, and repository access
        env:
          GH_TOKEN: ${{ steps.app-token.outputs.token }}
          APP_SLUG: ${{ steps.app-token.outputs.app-slug }}
          INSTALLATION_ID: ${{ steps.app-token.outputs.installation-id }}
          AUTOMATION_BOT_LOGIN: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
        run: |
          set -euo pipefail
          expected_slug="${AUTOMATION_BOT_LOGIN%\[bot\]}"
          test -n "$expected_slug"
          test "$APP_SLUG" = "$expected_slug"
          [[ "$INSTALLATION_ID" =~ ^[1-9][0-9]*$ ]]
          test "$(gh api "repos/$GITHUB_REPOSITORY" --jq .full_name)" = "$GITHUB_REPOSITORY"
  assistant:
    needs: intent
    if: needs.intent.outputs.route == 'true'
    uses: ./.github/workflows/codekeeper-runtime-assistant.yml
    with:
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      enabled: ${{ vars.CODEKEEPER_ENABLED == 'true' }}
      owner_requests: true
      installed_modes: review,maintain,issues,fix
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
      app_contents_permission: "APP_CONTENTS_PERMISSION"
      app_issues_permission: "APP_ISSUES_PERMISSION"
      app_pull_requests_permission: "APP_PULL_REQUESTS_PERMISSION"
    secrets:
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

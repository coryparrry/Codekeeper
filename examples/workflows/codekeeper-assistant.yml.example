# Copy to .github/workflows/codekeeper-assistant.yml, then replace OWNER/REPOSITORY
# and FULL_COMMIT_SHA with the published maintainer repository and release commit.
name: Codekeeper repository assistant
run-name: "Codekeeper assistant #${{ github.event.issue.number || github.event.pull_request.number }}"

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

permissions:
  contents: read
  issues: read
  pull-requests: read

jobs:
  bootstrap:
    name: Codekeeper pinned tooling bootstrap
    runs-on: ubuntu-latest
    steps:
      - uses: OWNER/REPOSITORY/tools/codekeeper@FULL_COMMIT_SHA
        with:
          artifact-name: codekeeper-tooling-${{ github.run_id }}
  assistant:
    needs: bootstrap
    uses: OWNER/REPOSITORY/.github/workflows/codekeeper-assistant.yml@FULL_COMMIT_SHA
    with:
      enabled: ${{ vars.CODEKEEPER_ENABLED == 'true' }}
      owner_requests: true
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
    secrets:
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

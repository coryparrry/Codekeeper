# Copy to .github/workflows/ai-maintainer-review.yml, then replace OWNER/REPOSITORY
# and FULL_COMMIT_SHA with the published maintainer repository and release commit.
name: AI Maintainer review

on:
  pull_request_target:
    types: [opened, reopened, synchronize, ready_for_review]

permissions:
  contents: read
  pull-requests: read

jobs:
  review:
    uses: OWNER/REPOSITORY/.github/workflows/ai-maintainer-review.yml@FULL_COMMIT_SHA
    with:
      enabled: ${{ vars.AI_MAINTAINER_ENABLED == 'true' }}
      automation_bot_login: ${{ vars.AI_MAINTAINER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.AI_MAINTAINER_APP_CLIENT_ID }}
    secrets:
      openai_api_key: ${{ secrets.OPENAI_API_KEY }}
      app_private_key: ${{ secrets.AI_MAINTAINER_APP_PRIVATE_KEY }}

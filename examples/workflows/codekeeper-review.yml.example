# Generated by the Codekeeper installer from one exact published package release.
name: Codekeeper review
run-name: "Codekeeper review #${{ github.event.pull_request.number || github.event.client_payload.number }} @${{ github.event.pull_request.head.sha || github.event.client_payload.head_sha }}"

on:
  pull_request_target:
    types: [opened, reopened, synchronize, ready_for_review]
  pull_request_review:
    types: [submitted, edited, dismissed]
  pull_request_review_comment:
    types: [created, edited, deleted]
  repository_dispatch:
    types: [codekeeper_review]

permissions:
  contents: read
  pull-requests: read

# Same-repository, non-draft stacked PRs receive review publication. Forks,
# drafts, and merge queues remain manual; stacked targets never auto-repair or
# auto-merge. Intent routing runs inside the reusable workflow so an eligible
# review does not allocate a separate machine before analysis.
jobs:
  review:
    # Deterministic no-op feedback is filtered without allocating a runner.
    # Mention-based owner commands still enter the reusable workflow so its
    # canonical parser can route them without duplicating regex policy here.
    # CODEKEEPER_OWNER_COMMANDS_START
    if: >-
      !(
        (github.event_name == 'pull_request_review' ||
         github.event_name == 'pull_request_review_comment') &&
        (
          vars.CODEKEEPER_AUTOMATION_BOT_LOGIN == '' ||
          github.event.review.user.login == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN ||
          github.event.comment.user.login == vars.CODEKEEPER_AUTOMATION_BOT_LOGIN
        )
      ) &&
      !(
        github.event_name == 'pull_request_review_comment' &&
        contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association) &&
        contains(fromJSON('["/codekeeper help","/codekeeper status","/codekeeper review","/codekeeper rerun","/codekeeper triage","/codekeeper implement","/codekeeper repair","/codekeeper fix","/codekeeper defer","/codekeeper pause","/codekeeper stop"]'), github.event.comment.body)
      )
    # CODEKEEPER_OWNER_COMMANDS_END
    uses: ./.github/workflows/codekeeper-runtime-review.yml
    with:
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      enabled: ${{ vars.CODEKEEPER_ENABLED == 'true' }}
      auto_review: true
      feedback_triage: true
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
      app_contents_permission: "APP_CONTENTS_PERMISSION"
      app_issues_permission: "APP_ISSUES_PERMISSION"
      app_pull_requests_permission: "APP_PULL_REQUESTS_PERMISSION"
    secrets:
      # Match this secret to ai.agents.review.provider in .github/codekeeper.json.
      model_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Required while this mode keeps workspace.enabled=true.
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Always a separate OpenAI trace-export key, never the model-provider key.
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}

# Generated by the Codekeeper installer from one exact published package release.
name: Codekeeper review
run-name: "Codekeeper review #${{ github.event.pull_request.number || github.event.client_payload.number }} @${{ github.event.pull_request.head.sha || github.event.client_payload.head_sha }}"

on:
  pull_request_target:
    types: [opened, reopened, synchronize, ready_for_review]
  pull_request_review:
    types: [submitted, edited, dismissed]
  pull_request_review_comment:
    types: [created, edited, deleted]
  repository_dispatch:
    types: [codekeeper_review]

permissions:
  contents: read
  pull-requests: read

jobs:
  intent:
    name: Detect Codekeeper review feedback
    runs-on: ${{ vars.CODEKEEPER_RUNNER || 'ubuntu-latest' }}
    outputs:
      owner_command: ${{ steps.intent.outputs.owner_command }}
      route: ${{ steps.intent.outputs.route }}
    steps:
      - name: Exclude owner commands and automation replies
        id: intent
        env:
          EVENT_NAME: ${{ github.event_name }}
          COMMENT_BODY: ${{ github.event.comment.body }}
          COMMENT_AUTHOR: ${{ github.event.comment.user.login }}
          REVIEW_AUTHOR: ${{ github.event.review.user.login }}
          AUTHOR_ASSOCIATION: ${{ github.event.comment.author_association }}
          AUTOMATION_BOT_LOGIN: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
        run: |
          node --input-type=module -e '
            import { appendFileSync } from "node:fs";
            const eventName = String(process.env.EVENT_NAME ?? "");
            const body = String(process.env.COMMENT_BODY ?? "").trim();
            const commentAuthor = String(process.env.COMMENT_AUTHOR ?? "").toLowerCase();
            const reviewAuthor = String(process.env.REVIEW_AUTHOR ?? "").toLowerCase();
            const author = eventName === "pull_request_review" ? reviewAuthor : commentAuthor;
            const association = String(process.env.AUTHOR_ASSOCIATION ?? "");
            const automationBot = String(process.env.AUTOMATION_BOT_LOGIN ?? "").toLowerCase();
            const mentionBot = automationBot.replace(/\[bot\]$/i, "");
            const escapedMention = mentionBot.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            const actions = ["status", "review", "rerun", "triage", "defer", "implement", "fix", "stop"];
            const slash = new RegExp(`^/codekeeper\\s+(${actions.join("|")})$`, "i").test(body);
            const botMention = mentionBot && new RegExp(`^@${escapedMention}(?:\\s|$)`, "i").test(body);
            const mentioned = mentionBot && new RegExp(`^@${escapedMention}\\s+(${actions.join("|")})$`, "i").test(body);
            const trustedAssociation = ["OWNER", "MEMBER", "COLLABORATOR"].includes(association);
            const commandIntent = eventName === "pull_request_review_comment" && trustedAssociation && (slash || mentioned);
            const feedbackEvent = eventName === "pull_request_review" || eventName === "pull_request_review_comment";
            const automationReply = feedbackEvent && automationBot && author === automationBot;
            const route = (!feedbackEvent || Boolean(automationBot)) && !commandIntent && !automationReply && !botMention;
            appendFileSync(process.env.GITHUB_OUTPUT, `owner_command=${commandIntent}\nroute=${route}\n`);
          '
  bootstrap:
    needs: intent
    if: needs.intent.outputs.route == 'true'
    name: Codekeeper exact package bootstrap
    permissions:
      contents: read
    uses: ./.github/workflows/codekeeper-bootstrap.yml
    with:
      runner: ${{ vars.CODEKEEPER_RUNNER || 'ubuntu-latest' }}
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
  review:
    needs: [intent, bootstrap]
    if: needs.intent.outputs.route == 'true' && needs.bootstrap.result == 'success'
    uses: ./.github/workflows/codekeeper-runtime-review.yml
    with:
      package_version: "PACKAGE_VERSION"
      package_integrity: "PACKAGE_INTEGRITY"
      package_manifest_sha256: ${{ needs.bootstrap.outputs.package_manifest_sha256 }}
      package_source_commit: ${{ needs.bootstrap.outputs.source_commit }}
      enabled: ${{ vars.CODEKEEPER_ENABLED == 'true' }}
      runner: ${{ vars.CODEKEEPER_RUNNER || 'ubuntu-latest' }}
      auto_review: true
      feedback_triage: true
      owner_command: ${{ needs.intent.outputs.owner_command == 'true' }}
      automation_bot_login: ${{ vars.CODEKEEPER_AUTOMATION_BOT_LOGIN }}
      app_client_id: ${{ vars.CODEKEEPER_APP_CLIENT_ID }}
      trace_exporter: ${{ vars.CODEKEEPER_TRACE_EXPORTER || 'openai' }}
      braintrust_project: ${{ vars.CODEKEEPER_BRAINTRUST_PROJECT || 'Codekeeper' }}
      braintrust_api_url: ${{ vars.CODEKEEPER_BRAINTRUST_API_URL || '' }}
      braintrust_include_sensitive_data: ${{ vars.CODEKEEPER_BRAINTRUST_INCLUDE_SENSITIVE_DATA == 'true' }}
    secrets:
      # Match this secret to ai.agents.review.provider in .github/codekeeper.json.
      model_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Required while this mode keeps workspace.enabled=true.
      workspace_api_key: ${{ secrets.OPENAI_API_KEY }}
      # Always a separate OpenAI trace-export key, never the model-provider key.
      trace_api_key: ${{ secrets.OPENAI_TRACE_API_KEY }}
      # Optional unless CODEKEEPER_TRACE_EXPORTER=braintrust.
      braintrust_api_key: ${{ secrets.BRAINTRUST_API_KEY }}
      app_private_key: ${{ secrets.CODEKEEPER_APP_PRIVATE_KEY }}
